---
layout: default
---
{%- comment -%}
  A work's own page (a paper, talk, tool, method, dataset or poster), from its file in _projects/.
  The front matter gives what the layout draws: the head (kind, venue, date, title, byline), the picture, and at the
  foot the related works, the citation map, the media and the citation. Everything Parker writes is the file's body, in
  Markdown: its first paragraph is the summary, a numbered list shows as findings, a definition list as details, a
  paragraph followed by {: .links} as a row of links. See _projects/_template.md.
{%- endcomment -%}
{%- assign slug = page.slug | default: page.name | remove: '.md' -%}
{%- comment -%} the page takes its journal's accent colour (_data/venues.yml), on the body so it reaches the header too {%- endcomment -%}
{%- assign venue = site.data.venues[page.venue_key] -%}
{%- if venue.color %}
  <style>
    body { --shu: {{ venue.color }}; }
    @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) body { --shu: {{ venue.color_dark | default: venue.color }}; } }
    :root[data-theme="dark"] body { --shu: {{ venue.color_dark | default: venue.color }}; }
  </style>
{%- endif %}
<article class="view" data-page="{{ slug }}">
  <p class="eyebrow">{{ page.kind }}{% if page.venue %} · {{ page.venue }}{% endif %} · {{ page.date | date: '%B %Y' }}</p>
  <h1 class="page-title">{{ page.title }}</h1>
  {% if page.byline %}<p class="byline">{{ page.byline | markdownify | remove: '<p>' | remove: '</p>' | strip }}</p>{% endif %}

  {% if page.image %}
    <div class="plate wide"><img src="{{ page.image | relative_url }}" alt="{{ page.image_alt | escape }}"></div>
  {% else %}
    <div class="plate wide"><span>{{ page.wide_label | default: page.plate_label | default: page.kind }}</span>{% if page.badge %}<span class="badge">{{ page.badge }}</span>{% endif %}</div>
  {% endif %}

  {{ content | replace_first: '<p>', '<p class="lede">' | replace: '<dl>', '<dl class="facts">' }}
  {% if page.placeholder %}<p class="note">Placeholder: this work and its details stand in until the real ones are written.</p>{% endif %}

  <figure class="qr" data-qr="{{ slug }}" data-name="this {{ page.kind | downcase }}"></figure>

  {% if page.related %}
    <h2>{{ page.related_title | default: 'Related' }}</h2>
    <div class="related">
      {%- for r in page.related %}
        {%- assign rw = site.projects | where: 'slug', r | first -%}
        {%- if rw %}
          <a href="{{ rw.url | relative_url }}">{% include work_plate.liquid work=rw thumb=true %}<span class="kind">{{ rw.kind }} · {{ rw.date | date: '%Y' }}</span><span class="t">{{ rw.short_title | default: rw.title }}</span></a>
        {%- endif %}
      {%- endfor %}
    </div>
  {% endif %}

  {% if page.cites %}
    <h2>Citation map</h2>
    <p class="note">What this paper cites, and what cites it, from Crossref on {{ page.cites_checked | default: 'the last rebuild' }}. Select a work to open it.</p>
    <div class="cmap" id="cmap">
      <svg class="cmap-lines" aria-hidden="true"></svg>
      <div class="cmap-col" data-side="refs"><span class="kind" id="refsHead">It cites</span></div>
      <div class="cmap-me"><span class="cmap-node"></span><span class="kind">This paper</span><span class="t">{{ page.short_title | default: page.title }}</span><span class="yr">{{ page.date | date: '%b %Y' }}</span></div>
      <div class="cmap-col" data-side="by"><span class="kind" id="byHead">Cited by · 0</span><p class="cmap-empty" id="byEmpty">Nothing cites it yet. Citing papers will appear here as they come out.</p></div>
    </div>
  {% endif %}

  {% if page.media %}
    <h2>In the media</h2>
    <ul class="mentions">
      {%- for m in page.media %}<li><span class="yr">{{ m.date }}</span><span>{% if m.url %}<a href="{{ m.url }}">{{ m.title }}</a>{% else %}{{ m.title }}{% endif %}</span><span class="kind">{{ m.kind }}</span></li>{% endfor -%}
    </ul>
  {% endif %}

  {% if page.bibtex %}
    <h2>Cite this</h2>
    <div class="code">{{ page.bibtex | escape | strip }}</div>
  {% endif %}
</article>
